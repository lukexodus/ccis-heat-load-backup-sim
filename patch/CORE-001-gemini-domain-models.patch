+        battery_charge_kwh=0.0,
+        battery_discharge_kwh=0.0,
+        grid_import_kwh=10.0,
+        unserved_load_kwh=0.0,
+        grid_available=True,
+        active_load_tier=3,
+    )
+    with pytest.raises(FrozenInstanceError):
+        record.demand_gross_kwh = 15.0  # type: ignore
+
+
